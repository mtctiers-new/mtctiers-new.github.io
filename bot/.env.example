# MTCTiers Discord Bot Configuration (.env)
# Copy this file to .env and fill in your details

# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID (Application ID) from Discord Developer Portal
CLIENT_ID=your_discord_client_id_here

# Target Server Guild ID (Single Server Mode for instant slash command registration)
GUILD_ID=your_discord_server_id_here

# Channel ID for Duel Announcements (e.g. #duel-announcements channel)
ANNOUNCEMENT_CHANNEL_ID=your_announcement_channel_id_here

# Whitelisted Admin Role IDs (Comma-separated. Members with any of these roles can use Admin commands)
ADMIN_ROLE_IDS=1471337796961829156,1509248567922004028,1471336340258951309

# Firebase Firestore Project ID (defaults to mtctiers)
FIREBASE_PROJECT_ID=mtctiers
